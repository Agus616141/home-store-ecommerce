// Fuente única de verdad del modelo de datos
// Motor: PostgreSQL | ORM: Prisma 7
// Dueño: Agente Base de Datos — ningún otro agente modifica este archivo

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────
// Alineados con packages/types — si cambia uno, cambia el otro en el mismo commit

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist?

  @@index([deletedAt])
  @@map("users")
}

// ─── ADDRESS ──────────────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String? // "Casa", "Trabajo", etc.
  street     String
  city       String
  state      String
  postalCode String
  country    String  @default("AR")
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── CATEGORY (árbol con parentId) ────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

// ─── PRODUCT ──────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  priceCents  Int       // precio en centavos enteros — nunca Float
  stock       Int       @default(0)
  sku         String?   @unique
  color       String?
  material    String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  images        ProductImage[]
  categories    ProductCategory[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([isActive, createdAt])
  @@index([isFeatured, isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Join table Producto ↔ Categoría (muchos a muchos)
model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// ─── CART ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique // un solo carrito por usuario
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      // >= 1, validado en aplicación
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // un item por producto en el carrito
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ─── ORDER ────────────────────────────────────────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Totales en centavos enteros
  subtotalCents Int
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int

  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  // Snapshot de dirección al momento de la compra (no FK — los datos no deben mutar)
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId, status]) // consultas "mis pedidos pendientes"
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // nullable: producto puede borrarse (soft), la orden debe persistir

  // Snapshot al momento de la compra — independiente del precio/nombre actuales
  productName    String
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int

  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── REVIEW ───────────────────────────────────────────────────────────────────

model Review {
  id                 String    @id @default(cuid())
  userId             String
  productId          String
  rating             Int       // 1–5, validado en aplicación con Zod
  title              String?
  body               String?
  isVerifiedPurchase Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId]) // una reseña por usuario por producto
  @@index([productId, rating])  // consultas de rating promedio por producto
  @@index([userId])
  @@index([deletedAt])
  @@map("reviews")
}

// ─── WISHLIST ─────────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique // una wishlist por usuario
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId]) // un item por producto en la wishlist
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ─── STRIPE EVENT (idempotencia de webhooks) ──────────────────────────────────
// Usamos el ID del evento Stripe como PK para garantizar procesamiento único

model StripeEvent {
  id          String   @id // evt_xxx — ID nativo de Stripe, no cuid
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@index([type])
  @@map("stripe_events")
}
