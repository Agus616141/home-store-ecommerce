NODE_ENV=development
PORT=8080

# PostgreSQL via Docker
# Levantar con: docker compose up -d (desde la raíz del monorepo)
DATABASE_URL="postgresql://homestore:homestore_dev@localhost:5432/homestore"
# DIRECT_URL: conexión directa (sin pooler) que usa `prisma migrate`.
# En local suele ser igual a DATABASE_URL. En Railway, separada (ver notas de deploy).
DIRECT_URL="postgresql://homestore:homestore_dev@localhost:5432/homestore"

# JWT — mínimo 32 caracteres cada uno (generá con: openssl rand -hex 32)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_seguro_minimo_32_chars
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro_minimo_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL canónica (para CORS y redirects/success_url de pagos)
# En producción: el dominio EXACTO de Vercel, ej: https://home-store.vercel.app
CLIENT_URL=http://localhost:5173
# Orígenes CORS adicionales separados por coma (ej: previews de Vercel). Opcional.
# CORS_ORIGINS=https://home-store-git-dev.vercel.app,https://home-store-pr-1.vercel.app

# Pagos: simulador activo por defecto (confirma el pago al instante, sin Stripe real).
# Poner false cuando se configure Stripe real abajo.
PAYMENTS_SIMULATOR=true

# Stripe (completar cuando se use pago real y poner PAYMENTS_SIMULATOR=false)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
