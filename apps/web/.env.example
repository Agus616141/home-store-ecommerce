# Plantilla de variables de entorno para DESARROLLO (Vite).
# Copiar a `.env.local` (ignorado por git):  cp .env.example .env.local
#
# Vite solo expone variables con prefijo VITE_ al cliente.

# URL base de la API local (sin barra final, SIN /api — los endpoints ya lo llevan)
VITE_API_URL=http://localhost:8080
